{
  "name": "tech-intern-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "oxlint app components hooks lib scripts tests types --quiet",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "inspect:workbook": "node --env-file-if-exists=.env.local --import tsx scripts/inspect-workbook.ts",
    "migrate:company-fields": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-company-fields.ts",
    "verify:environment": "node --env-file-if-exists=.env.local --import tsx scripts/verify-environment.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.102.8",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "1.31.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "3.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "type": "module"
}
